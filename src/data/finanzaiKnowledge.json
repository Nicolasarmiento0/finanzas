  "followUpPatterns": [
    {
      "pattern": "\\b(?:y\\s+)?(?:en\\s+)?(\\d+)\\s+cuotas?\\b",
      "updates": {
        "paymentMode": "installments",
        "installments": "$1"
      },
      "inheritIntentIfMissing": ["what_if_spend", "wishlist_evaluation"]
    },
    {
      "pattern": "\\b(?:y\\s+)?(?:al\\s+contado|en\\s+efectivo|con\\s+debito)\\b",
      "updates": {
        "paymentMode": "cash",
        "installments": 1
      },
      "inheritIntentIfMissing": ["what_if_spend", "wishlist_evaluation"]
    },
    {
      "pattern": "\\b(?:y\\s+)?(?:si\\s+(?:pago|uso|es)\\s+)?(?:con\\s+(?:la\\s+)?)?(santander|cmr|falabella)\\b",
      "updates": {
        "cardBrand": "$1"
      },
      "inheritIntentIfMissing": ["what_if_spend", "credit_card_details", "wishlist_evaluation"]
    },
    {
      "pattern": "\\b(?:y\\s+)?(?:si\\s+es\\s+)?(?:la\\s+mitad|50%)\\b",
      "updates": {
        "amountMultiplier": 0.5
      },
      "inheritIntentIfMissing": ["what_if_spend", "safe_to_save", "windfall_bonus", "goal_target_reach"]
    }
  ],
  "domainContext": {
    "glossary": {
      "safe_to_spend": "Presupuesto libre del mes restante dividido por los días que quedan del mes calendario, sin descalzar gastos fijos.",
      "net_worth_with_savings": "Ingresos mensuales + saldo total en cuentas de ahorro - deuda total activa.",
      "net_worth_without_savings": "Ingresos mensuales - deuda total activa (mide margen operativo sin tocar ahorros).",
      "temporal_validity": "Los ítems recurrentes y cuotas respetan start_date y end_date; al expirar, el flujo se libera automáticamente para ahorro futuro.",
      "shared_savings_partner": "Cuentas de ahorro vinculadas entre 2 usuarios en D1 con inversión automática de roles (Tú vs Pareja).",
      "ten_percent_surplus_rule": "Simulación que destina un 10% adicional del remanente libre del checklist al ahorro compuesto.",
      "future_purchases_viability": "Evalúa deseos de compra como viable_today, viable_planned (al liberarse deudas) o postpone."
    },
    "responseRules": [
      "Nunca inventes ni estimes montos: cita exclusivamente cifras devueltas por las herramientas o snapshot del servidor.",
      "Formatea todos los montos en CLP sin decimales con separador de miles por punto (ejemplo: $45.000).",
      "Usa español natural cercano a Chile cuando corresponda (sin abusar de jerga), claro y accionable.",
      "Si el Modo Privado/Camuflaje está activo en el cliente, la UI enmascarará los montos antes de mostrarlos."
    ]
  }
